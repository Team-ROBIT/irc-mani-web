<style>
  .legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.875rem; color: var(--color-neutral-600); }
  .chip { display: inline-flex; align-items: center; gap: 0.5rem; }
  .chip i { width: 22px; height: 14px; border-radius: 3px; border: 1.5px solid; display: inline-block; box-sizing: border-box; }
  .chip.dev i { background: #fff; border-color: var(--color-neutral-500); }
  .chip.per i { background: #fff; border-color: var(--color-ink); }
  .chip.ctl i { background: var(--color-accent); border-color: var(--color-accent); }
  .chip.voc i { background: #fff; border-color: var(--color-accent); border-style: dashed; }
  .chip.exe i { background: var(--color-neutral-200); border-color: var(--color-neutral-600); }
  .panel { margin-top: 1rem; overflow-x: auto; border: 1px solid var(--color-neutral-300); border-radius: 1.5rem; background: var(--color-paper); }
  svg { display: block; width: 100%; min-width: 900px; height: auto; font-family: var(--font-sans); }
  .ln { fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .e-dev { stroke: var(--color-neutral-500); } .e-per { stroke: var(--color-ink); } .e-ctl { stroke: var(--color-accent); }
  .e-voc { stroke: var(--color-accent); stroke-dasharray: 5 4; } .e-exe { stroke: var(--color-neutral-600); }
  .m-dev { fill: var(--color-neutral-500); } .m-per { fill: var(--color-ink); } .m-ctl { fill: var(--color-accent); } .m-voc { fill: var(--color-accent); } .m-exe { fill: var(--color-neutral-600); }
  .pill { fill: var(--color-paper); stroke: var(--color-neutral-300); stroke-width: 1; }
  .pt { font-size: 14px; font-weight: 500; fill: var(--color-ink); }
  .tick { fill: none; stroke: var(--color-accent); stroke-width: 1.5; }
  .div { fill: none; stroke: var(--color-neutral-200); stroke-width: 1; }
  .zone { fill: var(--color-neutral-100); stroke: var(--color-neutral-400); stroke-width: 1; stroke-dasharray: 3 4; opacity: 0.8; }
  .zt { font-size: 14px; font-weight: 700; fill: var(--color-neutral-500); letter-spacing: 0.04em; }
  .nb { stroke-width: 1.6; }
  .n-dev { fill: #fff; stroke: var(--color-neutral-500); } .n-per { fill: #fff; stroke: var(--color-ink); }
  .n-ctl { fill: var(--color-accent); stroke: var(--color-accent); } .n-voc { fill: #fff; stroke: var(--color-accent); } .n-exe { fill: var(--color-neutral-200); stroke: var(--color-neutral-600); }
  .nt { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; } .ns { font-size: 14px; font-weight: 400; opacity: 0.9; }
  .t-dev { fill: var(--color-neutral-600); } .t-per { fill: var(--color-ink); } .t-ctl { fill: var(--color-paper); } .t-voc { fill: var(--color-accent); } .t-exe { fill: var(--color-ink); }
  .node { cursor: default; outline: none; }
  .node:focus-visible .nb { stroke-width: 3; }
  .edge, .node { transition: opacity 0.15s; }
  svg.focus .edge:not(.on) { opacity: 0.1; }
  svg.focus .node:not(.on) { opacity: 0.3; }
  svg.focus .zone, svg.focus .zt { opacity: 0.35; }
  svg.focus .edge.on .ln { stroke-width: 3; }
  @media (prefers-reduced-motion: reduce) { .edge, .node { transition: none; } }
</style>

<script>
  const svg = document.getElementById('node-flow');
  if (svg) {
    const nodes = svg.querySelectorAll<SVGGElement>('.node');
    const edges = svg.querySelectorAll<SVGGElement>('.edge');
    const on = (id: string) => {
      const near = new Set([id]);
      edges.forEach((e) => {
        const hit = e.dataset.from === id || e.dataset.to === id;
        e.classList.toggle('on', hit);
        if (hit) {
          near.add(e.dataset.from!);
          near.add(e.dataset.to!);
        }
      });
      nodes.forEach((n) => n.classList.toggle('on', near.has(n.dataset.id!)));
      svg.classList.add('focus');
    };
    const off = () => {
      svg.classList.remove('focus');
      edges.forEach((e) => e.classList.remove('on'));
      nodes.forEach((n) => n.classList.remove('on'));
    };
    nodes.forEach((n) => {
      n.addEventListener('mouseenter', () => on(n.dataset.id!));
      n.addEventListener('mouseleave', off);
      n.addEventListener('focus', () => on(n.dataset.id!));
      n.addEventListener('blur', off);
    });
  }
</script>
