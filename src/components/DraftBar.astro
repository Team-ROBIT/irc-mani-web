---
// 시안 페이지 상단의 이동 막대. 시안 비교가 끝나면 삭제한다.
interface Props {
  current: string;
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const keys = ['a', 'b', 'c', 'd'];
---

<nav class="fixed right-3 bottom-3 z-50 flex items-center gap-1 rounded-full bg-black/80 p-1 text-xs text-white shadow-lg backdrop-blur">
  <a href={`${base}/`} class="rounded-full px-3 py-1.5 hover:bg-white/15">목록</a>
  {
    keys.map((k) => (
      <a
        href={`${base}/drafts/${k}/`}
        class:list={['rounded-full px-3 py-1.5 font-bold', k === current ? 'bg-white text-black' : 'hover:bg-white/15']}
        aria-current={k === current ? 'page' : undefined}
      >
        {k.toUpperCase()}
      </a>
    ))
  }
</nav>
