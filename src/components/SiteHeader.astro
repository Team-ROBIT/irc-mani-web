---
import { project, nav } from '../data/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<header class:list={['sticky top-0 z-40 border-b border-neutral-200/70 bg-paper/85 backdrop-blur', className]}>
  <div class="wrap flex items-center justify-between gap-6 py-4">
    <a href="#top" class="text-lg font-extrabold tracking-tight">{project.name}</a>
    <nav class="hidden gap-7 text-sm font-medium text-neutral-500 md:flex">
      {nav.map((n) => <a href={`#${n.id}`} class="hover:text-ink">{n.label}</a>)}
    </nav>
  </div>
</header>
