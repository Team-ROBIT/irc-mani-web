---
import { software, motionPlanner } from '../../data/site';

const owner = software.modules.find((m) => m.key === 'motion-planner')?.owner;
---

<div id="software-motion-planner" class="mt-24 border-t border-neutral-200 pt-16">
  <p class="text-sm font-semibold text-accent">소프트웨어 상세 · 담당 {owner}</p>
  <h3 class="reveal mt-3 text-4xl font-extrabold tracking-tight lg:text-5xl">Motion Planner</h3>
  <p class="reveal mt-6 max-w-3xl text-2xl leading-snug font-bold">{motionPlanner.easy}</p>
  <p class="mt-4 font-mono font-semibold">{motionPlanner.stack}</p>

  <ol class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {
      motionPlanner.flow.map((f, i) => (
        <li class="reveal rounded-3xl border border-neutral-200 bg-white p-6" style={`--i: ${i}`}>
          <p class="text-sm font-bold text-accent">{String(i + 1).padStart(2, '0')}</p>
          <p class="mt-1 text-xl font-bold">{f.name}</p>
          <p class="mt-3 leading-relaxed text-neutral-700">{f.body}</p>
        </li>
      ))
    }
  </ol>

  <div class="mt-12 grid gap-10 lg:grid-cols-2">
    <div>
      <h4 class="text-2xl font-bold">계획 설정</h4>
      <dl class="mt-5 space-y-2">
        {
          motionPlanner.settings.map((s) => (
            <div class="flex items-baseline justify-between gap-4 rounded-2xl bg-white px-5 py-3">
              <dt class="text-neutral-500">{s.label}</dt>
              <dd class="text-right font-semibold">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div>
      <h4 class="text-2xl font-bold">직접 개선</h4>
      <ul class="mt-5 space-y-3 text-sm leading-relaxed text-neutral-600">
        {
          motionPlanner.features.map((f) => (
            <li class="border-t border-neutral-200 pt-3">
              <p class="text-base font-bold text-ink">{f.name}</p>
              <p class="mt-1">
                <span class="font-semibold text-ink">문제</span> {f.problem}
              </p>
              <p class="mt-1">
                <span class="font-semibold text-ink">해결</span> {f.solution}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="mt-8 text-sm text-neutral-500">
    아직 측정하지 못한 항목: {motionPlanner.unmeasured.join(' · ')}
  </p>
</div>
