---
import Media from '../Media.astro';
import { software, vision } from '../../data/site';

const owner = software.modules.find((m) => m.key === 'vision')?.owner;
---

<div id="software-vision" class="mt-24 border-t border-neutral-200 pt-16">
  <p class="text-sm font-semibold text-accent">소프트웨어 상세 · 담당 {owner}</p>
  <h3 class="reveal mt-3 text-4xl font-extrabold tracking-tight lg:text-5xl">Vision</h3>
  <p class="reveal mt-6 max-w-3xl text-2xl leading-snug font-bold">{vision.easy}</p>
  <p class="reveal mt-4 max-w-4xl text-lg leading-relaxed text-neutral-600">{vision.summary}</p>

  <div class="reveal mt-10 rounded-3xl bg-ink p-7 text-white sm:p-9">
    <p class="text-xl font-bold">{vision.principle.title}</p>
    <p class="mt-3 max-w-4xl leading-relaxed text-neutral-300">{vision.principle.body}</p>
  </div>

  <h4 class="mt-16 text-2xl font-bold">센서 구성</h4>
  <div class="mt-6 grid gap-4 md:grid-cols-3">
    {
      vision.sensors.map((s, i) => (
        <div class="reveal rounded-3xl border border-neutral-200 bg-white p-6" style={`--i: ${i}`}>
          <p class="text-sm font-semibold text-neutral-500">{s.name}</p>
          <p class="mt-2 text-lg font-bold">{s.model}</p>
          <p class="mt-1 font-mono text-sm text-accent">{s.spec}</p>
          <p class="mt-3 text-sm leading-relaxed text-neutral-600">{s.role}</p>
        </div>
      ))
    }
  </div>
  <p class="mt-4 text-neutral-600">{vision.mounting}</p>
  <dl class="mt-4 grid gap-x-8 gap-y-3 text-sm md:grid-cols-3">
    {
      vision.alignment.map((a) => (
        <div class="border-t border-neutral-200 pt-3">
          <dt class="font-semibold">정렬 · {a.label}</dt>
          <dd class="mt-1 leading-relaxed text-neutral-600">{a.body}</dd>
        </div>
      ))
    }
  </dl>

  <h4 class="mt-16 text-2xl font-bold">핵심 기능 {vision.features.length}가지</h4>
  <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {
      vision.features.map((f, i) => (
        <article class="reveal flex flex-col overflow-hidden rounded-3xl border border-neutral-200 bg-white" style={`--i: ${i % 3}`}>
          {f.image && (
            <div class="bg-neutral-100 text-neutral-500">
              <Media id={f.image.id} label={f.image.label} spec="16:9 · 가로 1600px 이상" class="aspect-[16/9] w-full" sizes="(min-width: 1280px) 30vw, (min-width: 768px) 45vw, 100vw" />
            </div>
          )}
          <div class="flex flex-1 flex-col p-6">
            <p class="text-sm font-bold text-accent">{String(i + 1).padStart(2, '0')}</p>
            <h5 class="mt-1 text-2xl font-bold">{f.name}</h5>
            <p class="mt-3 leading-relaxed whitespace-pre-line text-neutral-700">{f.easy}</p>

            <ul class="mt-4 flex flex-wrap gap-1.5">
              {f.tags.map((t) => <li class="rounded-full bg-neutral-100 px-2.5 py-1 font-mono text-xs text-neutral-700">{t}</li>)}
            </ul>

            <div class="mt-auto">
              {f.metrics && (
                <dl class="mt-5 space-y-2 border-t border-neutral-200 pt-4">
                  {f.metrics.map((m) => (
                    <div class="flex items-baseline justify-between gap-4 text-sm">
                      <dt class="text-neutral-500">{m.label}</dt>
                      <dd class:list={['shrink-0 font-bold', m.value === null ? 'font-normal text-neutral-400' : 'text-lg']}>{m.value ?? '미측정'}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {(f.tech || f.improvements || f.limit) && (
                <details class="mt-5 border-t border-neutral-200 pt-4">
                  <summary class="cursor-pointer text-sm font-semibold text-accent select-none">기술 자세히 보기</summary>
                  <div class="mt-4 space-y-4 text-sm leading-relaxed text-neutral-600">
                    {f.tech && <p>{f.tech}</p>}
                    {f.improvements?.map((p) => (
                      <div class="rounded-2xl bg-neutral-50 p-4">
                        <p class="text-xs font-semibold text-neutral-500">직접 개선</p>
                        <p class="mt-1">
                          <span class="font-semibold text-ink">문제</span> {p.problem}
                        </p>
                        <p class="mt-1">
                          <span class="font-semibold text-ink">해결</span> {p.solution}
                        </p>
                      </div>
                    ))}
                    {f.limit && (
                      <p>
                        <span class="font-semibold text-ink">한계</span> {f.limit}
                      </p>
                    )}
                  </div>
                </details>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <h4 class="mt-16 text-2xl font-bold">학습과 성능</h4>
  <p class="mt-3 max-w-4xl text-neutral-600">{vision.training.note}</p>
  <div class="mt-6 overflow-x-auto rounded-3xl border border-neutral-200 bg-white">
    <table class="w-full min-w-[40rem] text-left text-sm">
      <thead class="border-b border-neutral-200 text-neutral-500">
        <tr>
          <th class="p-4 font-semibold">모델</th>
          <th class="p-4 font-semibold">학습 이미지<br /><span class="font-normal">train / valid / test</span></th>
          <th class="p-4 font-semibold">Precision</th>
          <th class="p-4 font-semibold">Recall</th>
          <th class="p-4 font-semibold">mAP@50</th>
          <th class="p-4 font-semibold">mAP@50:95</th>
        </tr>
      </thead>
      <tbody>
        {
          vision.training.rows.map((r) => (
            <tr class="border-b border-neutral-100 last:border-0">
              <td class="p-4 font-semibold">{r.name}</td>
              <td class="p-4">
                {r.images}
                <br />
                <span class="font-mono text-xs text-neutral-500">{r.split}</span>
              </td>
              <td class="p-4">{r.precision}</td>
              <td class="p-4">{r.recall}</td>
              <td class="p-4 font-bold">{r.map50}</td>
              <td class="p-4">{r.map5095}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-8 text-sm text-neutral-500">
    아직 측정하지 못한 항목: {vision.unmeasured.join(' · ')}
  </p>
</div>
