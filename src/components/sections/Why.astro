---
import SectionHeader from './SectionHeader.astro';
import { why } from '../../data/site';
---

<SectionHeader eyebrow="배경" title={why.title} />

<dl class="mt-14 grid gap-10 sm:grid-cols-3">
  {
    why.stats.map((s, i) => (
      <div class="reveal border-t-2 border-ink pt-5" style={`--i: ${i}`}>
        <dd class="text-6xl font-black tracking-tight lg:text-7xl">
          <span data-count={s.value} class="tabular-nums">{s.value}</span>
          <span class="text-3xl">{s.unit}</span>
        </dd>
        <dt class="mt-3 text-neutral-600">{s.label}</dt>
      </div>
    ))
  }
</dl>

<div class="mt-16 grid gap-10 md:grid-cols-3">
  {
    why.causes.map((c, i) => (
      <div class="reveal" style={`--i: ${i}`}>
        <span class="text-sm font-bold text-accent">0{i + 1}</span>
        <h3 class="mt-2 text-2xl font-bold">{c.title}</h3>
        <p class="mt-2 text-lg leading-relaxed text-neutral-600">{c.body}</p>
      </div>
    ))
  }
</div>

<h3 class="mt-20 text-2xl font-bold">{why.casesTitle}</h3>
<p class="mt-2 text-sm text-neutral-500">{why.casesNote}</p>
<div class="mt-6 grid gap-6 md:grid-cols-3">
  {
    why.cases.map((v, i) => (
      <article class="reveal flex flex-col overflow-hidden rounded-3xl border border-neutral-200 bg-white" style={`--i: ${i}`}>
        <div data-yt={v.id} data-title={v.title} class="relative aspect-video bg-neutral-100">
          <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer" aria-label={`${v.title} 영상 보기`} class="group absolute inset-0">
            <img
              src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              referrerpolicy="no-referrer"
              class="size-full object-cover"
            />
            <span class="absolute inset-0 grid place-items-center bg-black/10 transition-colors group-hover:bg-black/25" aria-hidden="true">
              <span class="grid size-14 place-items-center rounded-full bg-white/95 text-xl text-ink shadow">▶</span>
            </span>
          </a>
        </div>
        <div class="flex flex-1 flex-col p-5">
          <p class="text-xs font-semibold text-accent">영상 · {v.source}</p>
          <h4 class="mt-1 text-lg font-bold">{v.title}</h4>
          <p class="mt-2 text-sm leading-snug text-neutral-500">원제: {v.headline}</p>
          <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer" class="mt-auto pt-4 text-sm font-semibold text-accent hover:underline">
            YouTube에서 보기 ↗
          </a>
        </div>
      </article>
    ))
  }
</div>

<ul class="mt-10 space-y-1 text-xs text-neutral-500">
  {why.sources.map((s) => <li>출처: {s}</li>)}
</ul>

<script>
  // 통계 숫자가 화면에 들어오면 0부터 실제 값까지 올라간다. JS가 없으면 처음부터 실제 값이 보인다.
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const value = el.dataset.count!;
          const decimals = value.split('.')[1]?.length ?? 0;
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min((now - start) / 1000, 1);
            el.textContent = (Number(value) * (1 - (1 - t) ** 3)).toFixed(decimals);
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll('[data-count]').forEach((el) => observer.observe(el));
  }
</script>

<script>
  // 썸네일을 누르면 새 탭으로 가지 않고 같은 자리에서 재생한다. JS가 없으면 YouTube 링크로 이동한다.
  for (const box of document.querySelectorAll<HTMLElement>('[data-yt]')) {
    box.querySelector('a')?.addEventListener('click', (event) => {
      event.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1`;
      frame.title = box.dataset.title ?? '사례 영상';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'absolute inset-0 size-full';
      box.replaceChildren(frame);
    });
  }
</script>
