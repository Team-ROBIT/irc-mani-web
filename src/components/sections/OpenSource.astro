---
import SectionHeader from './SectionHeader.astro';
import { openSource } from '../../data/site';
---

<SectionHeader eyebrow="오픈소스" title={openSource.title} intro={openSource.intro} />

<!-- 넓은 화면에서는 모듈 묶음을 나란히 두고, SDK는 짧은 오른쪽 칸 아래에 붙인다 -->
<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-8">
  {
    openSource.groups.map((g, i) => (
      <div>
        <h3 class="text-lg font-bold">{g.name}</h3>
        <ul class="reveal mt-4 divide-y divide-neutral-100 rounded-3xl border border-neutral-200 bg-white">
          {g.items.map((r) => (
            <li class="px-5 py-3">
              <div class="flex items-baseline justify-between gap-4">
                <p class="min-w-0">
                  <span class="font-semibold">{r.name}</span>
                  <span class="ml-2 text-xs whitespace-nowrap text-neutral-500">{r.category}</span>
                </p>
                <a href={r.url} target="_blank" rel="noopener noreferrer" class="shrink-0 text-sm font-semibold text-accent hover:underline">
                  {r.linkLabel} ↗
                </a>
              </div>
              <p class="mt-1 text-sm leading-snug text-neutral-600">
                {r.purpose}
                <span class="mx-1.5 text-neutral-300">·</span>
                <span class="font-mono text-xs text-neutral-500">{r.license}</span>
              </p>
            </li>
          ))}
        </ul>

        {i === openSource.groups.length - 1 && (
          <>
            <h3 class="mt-10 text-lg font-bold">{openSource.sdkTitle}</h3>
            <ul class="reveal mt-4 divide-y divide-neutral-100 rounded-3xl border border-neutral-200 bg-white">
              {openSource.sdk.map((r) => (
                <li class="px-5 py-3">
                  <div class="flex items-baseline justify-between gap-4">
                    <p class="min-w-0 font-semibold">{r.name}</p>
                    <a href={r.url} target="_blank" rel="noopener noreferrer" class="shrink-0 text-sm font-semibold text-accent hover:underline">
                      {r.linkLabel} ↗
                    </a>
                  </div>
                  <p class="mt-1 text-sm leading-snug text-neutral-600">{r.purpose}</p>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    ))
  }
</div>
