---
import SectionHeader from './SectionHeader.astro';
import { system } from '../../data/site';

const { run, train } = system.diagram;
// 넓은 화면에서 학습 줄의 마지막 칸이 '동작 생성' 칸 바로 아래에 오도록 맞춘다.
const policyStage = run.stages.findIndex((s) => s.label === '동작 생성');
const trainStart = policyStage - train.stages.length + 1;
---

<SectionHeader eyebrow="시스템 구성" title={system.title} intro={system.intro} pending={system.pending ? '확정 전' : undefined} />

<figure class="diagram-figure mt-12 rounded-3xl border border-neutral-200 bg-white p-5 sm:p-8">
  <figcaption class="sr-only">SAFE LAB 시스템 구성도. 탑뷰 카메라 입력이 인식·판단, 계획, 동작 생성, 제어를 거쳐 매니퓰레이터의 동작이 되고, 리더암으로 모은 시연 데이터로 학습한 정책이 동작 생성에 쓰입니다.</figcaption>

  <p class="text-sm font-bold text-accent">{run.label}</p>
  <ol class="diagram-grid mt-4">
    {
      run.stages.map((stage, i) => (
        <li class="diagram-stage" style={`--col: ${i + 1}`} data-step={i}>
          <p class="text-sm font-semibold text-neutral-500">{stage.label}</p>
          <div class="mt-2 flex flex-1 flex-col gap-2">
            {stage.nodes.map((n) => (
              <div class="flex flex-1 flex-col justify-center rounded-xl border border-neutral-300 bg-paper p-3">
                <p class="font-bold">{n.name}</p>
                {n.note && <p class="mt-1 text-sm leading-snug text-neutral-600">{n.note}</p>}
              </div>
            ))}
          </div>
          {i < run.stages.length - 1 && <span class="diagram-arrow" aria-hidden="true" />}
        </li>
      ))
    }
  </ol>

  <div class="diagram-grid mt-8 xl:mt-0" aria-hidden="true">
    <span class="diagram-up hidden xl:block" style={`--col: ${policyStage + 1}`} data-step={run.stages.length + train.stages.length}></span>
  </div>

  <p class="text-sm font-bold text-neutral-500">{train.label}</p>
  <ol class="diagram-grid mt-4">
    {
      train.stages.map((node, i) => (
        <li class="diagram-stage" style={`--col: ${trainStart + i + 1}`} data-step={run.stages.length + i}>
          <div class="flex flex-1 flex-col justify-center rounded-xl border border-dashed border-neutral-400 p-3">
            <p class="font-bold">{node.name}</p>
            {node.note && <p class="mt-1 text-sm leading-snug text-neutral-600">{node.note}</p>}
          </div>
          {i < train.stages.length - 1 && <span class="diagram-arrow" aria-hidden="true" />}
        </li>
      ))
    }
  </ol>
</figure>

<ul class="mt-6 grid gap-4 sm:grid-cols-2">
  {
    system.items.map((item) => (
      <li class="rounded-2xl border border-dashed border-neutral-300 p-5 text-neutral-500">
        <p class="font-semibold text-ink">{item}</p>
        <p class="mt-1 text-sm">작성 예정</p>
      </li>
    ))
  }
</ul>

<style>
  .diagram-grid {
    display: grid;
    gap: 2rem;
  }

  .diagram-stage {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* 화살표: 좁은 화면에서는 아래로, 넓은 화면에서는 오른쪽으로 */
  .diagram-arrow {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 2rem;
    height: 2rem;
    transform: translateX(-50%);
    color: var(--color-neutral-400);
  }

  .diagram-arrow::before {
    content: '↓';
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 1.25rem;
  }

  @media (min-width: 80rem) {
    .diagram-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: 2rem;
    }

    .diagram-stage {
      grid-column: var(--col);
    }

    .diagram-arrow {
      top: 50%;
      left: 100%;
      transform: translateY(-50%);
    }

    .diagram-arrow::before {
      content: '→';
    }

    .diagram-up {
      grid-column: var(--col);
      height: 2.5rem;
      margin-top: 0.5rem;
      text-align: center;
      font-size: 1.25rem;
      color: var(--color-accent);
    }

    .diagram-up::before {
      content: '↑';
    }
  }
</style>
