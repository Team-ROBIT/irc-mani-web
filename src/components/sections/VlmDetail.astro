---
import { software, vlm, voice } from '../../data/site';

const owner = software.modules.find((m) => m.key === 'vlm')?.owner;
---

<div id="software-vlm" class="mt-24 border-t border-neutral-200 pt-16">
  <p class="text-sm font-semibold text-accent">소프트웨어 상세 · 담당 {owner}</p>
  <h3 class="reveal mt-3 text-4xl font-extrabold tracking-tight lg:text-5xl">VLM</h3>
  <p class="reveal mt-6 max-w-3xl text-2xl leading-snug font-bold">{vlm.easy}</p>
  <p class="mt-4 text-neutral-600">
    <span class="font-mono font-semibold text-ink">{vlm.model}</span> · {vlm.runtime}
  </p>

  <div class="mt-10 grid gap-4 lg:grid-cols-[1fr_auto_1fr] lg:items-stretch">
    <div class="reveal rounded-3xl border border-neutral-200 bg-white p-6">
      <p class="text-sm font-semibold text-neutral-500">입력</p>
      <ul class="mt-3 space-y-2">
        {vlm.input.map((t) => <li class="leading-relaxed">{t}</li>)}
      </ul>
    </div>
    <div class="hidden items-center text-3xl text-accent lg:flex" aria-hidden="true">→</div>
    <div class="reveal rounded-3xl border border-neutral-200 bg-white p-6" style="--i: 1">
      <p class="text-sm font-semibold text-neutral-500">출력</p>
      <ul class="mt-3 space-y-2">
        {vlm.output.map((t) => <li class="leading-relaxed">{t}</li>)}
      </ul>
    </div>
  </div>

  <div class="mt-12 grid gap-10 lg:grid-cols-2">
    <div>
      <h4 class="text-2xl font-bold">{vlm.priorityTitle}</h4>
      <ol class="mt-5 space-y-2">
        {
          vlm.priority.map((p, i) => (
            <li class="flex items-baseline gap-4 rounded-2xl bg-white px-5 py-3 font-semibold">
              <span class="font-bold text-accent">{i + 1}</span>
              {p}
            </li>
          ))
        }
      </ol>
      <p class="mt-3 text-sm text-neutral-500">{vlm.priorityNote}</p>
    </div>
    <div>
      <h4 class="text-2xl font-bold">계획을 만드는 규칙</h4>
      <ul class="mt-5 space-y-3 leading-relaxed text-neutral-700">
        {vlm.rules.map((r) => <li class="border-t border-neutral-200 pt-3">{r}</li>)}
      </ul>
      <p class="mt-5 text-sm leading-relaxed text-neutral-600">
        <span class="font-semibold text-ink">한계</span> {vlm.limit}
      </p>
    </div>
  </div>

  <h4 class="mt-16 text-2xl font-bold">계획 생성 사례</h4>
  <p class="mt-3 text-sm text-neutral-500">{vlm.casesNote}</p>
  <div class="mt-5 overflow-x-auto rounded-3xl border border-neutral-200 bg-white">
    <table class="w-full min-w-[32rem] text-left text-sm">
      <thead class="border-b border-neutral-200 text-neutral-500">
        <tr>
          <th class="p-4 font-semibold">사례</th>
          <th class="p-4 font-semibold">책상 위 물체</th>
          <th class="p-4 font-semibold">생성·검증 시간</th>
          <th class="p-4 font-semibold">토큰 (입력 / 출력)</th>
        </tr>
      </thead>
      <tbody>
        {
          vlm.cases.map((c) => (
            <tr class="border-b border-neutral-100 last:border-0">
              <td class="p-4 font-semibold">{c.name}</td>
              <td class="p-4">{c.scene}</td>
              <td class="p-4 font-bold">{c.time}</td>
              <td class="p-4 font-mono">{c.tokens}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h4 class="mt-16 text-2xl font-bold">{voice.title}</h4>
  <div class="mt-6 grid gap-4 md:grid-cols-2">
    {
      voice.items.map((v, i) => (
        <article class="reveal rounded-3xl border border-neutral-200 bg-white p-6" style={`--i: ${i}`}>
          <p class="text-sm font-semibold text-accent">{v.kind}</p>
          <p class="mt-2 text-xl font-bold">{v.model}</p>
          <p class="mt-3 leading-relaxed text-neutral-700">{v.body}</p>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {v.tags.map((t) => <li class="rounded-full bg-neutral-100 px-2.5 py-1 font-mono text-xs text-neutral-700">{t}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
</div>
