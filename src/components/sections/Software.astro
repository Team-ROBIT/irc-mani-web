---
import SectionHeader from './SectionHeader.astro';
import Media from '../Media.astro';
import VisionDetail from './VisionDetail.astro';
import VlmDetail from './VlmDetail.astro';
import ImitationDetail from './ImitationDetail.astro';
import MotionPlannerDetail from './MotionPlannerDetail.astro';
import { software } from '../../data/site';
---

<SectionHeader eyebrow="소프트웨어" title={software.title} intro={software.intro} pending={software.pending ? '일부 작성 중' : undefined} />

<!-- 카드가 탭 역할: 누른 모듈의 상세만 아래에 보인다. JS가 없으면 상세가 전부 보인다. -->
<div data-software-tabs>
  <div class="mt-12 grid gap-6 md:grid-cols-6">
    {
      software.modules.map((m, i) => (
        <article
          data-tab={m.key}
          class="rise relative flex flex-col overflow-hidden rounded-3xl border border-neutral-200 bg-white transition-colors hover:border-accent data-active:border-accent data-active:ring-2 data-active:ring-accent md:col-span-3"
          style={`--i: ${i % 2}`}
        >
          <div class="thumb-fade bg-neutral-100 text-neutral-500">
            <Media
              id={`software/${m.key}`}
              label={`${m.name} 결과 이미지`}
              spec="16:9 · 가로 1600px 이상"
              class="aspect-[16/9] w-full"
              sizes="(min-width: 768px) 50vw, 100vw"
            />
          </div>
          <div class="flex flex-1 flex-col p-7">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-2xl font-bold">{m.name}</h3>
              {m.owner && <span class="text-sm text-neutral-500">{m.owner}</span>}
            </div>
            <p class="mt-2 leading-relaxed text-neutral-600">{m.body}</p>
            {m.detail && (
              <a href={m.detail} data-tab-link={m.key} class="mt-4 text-sm font-semibold text-accent after:absolute after:inset-0">
                자세히 보기 ↓
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <p data-tabs-only hidden class="mt-6 text-neutral-500">카드를 누르면 아래에서 자세한 내용을 볼 수 있어요.</p>

  <!-- 탭 줄: 스크롤만 하는 사람도 다른 모듈이 있다는 걸 알 수 있게 패널 바로 위에 둔다 -->
  <div data-tabs-only data-tab-bar hidden role="tablist" aria-label="소프트웨어 모듈" class="mt-16 flex overflow-x-auto border-b border-neutral-200">
    {
      software.modules.map((m) => (
        <button
          type="button"
          role="tab"
          data-tab-button={m.key}
          class="-mb-px shrink-0 border-b-[3px] border-transparent px-3 py-3 text-sm font-semibold sm:px-6 sm:text-base whitespace-nowrap text-neutral-600 transition-colors hover:text-ink aria-selected:border-accent aria-selected:text-accent"
        >
          {m.name}
        </button>
      ))
    }
  </div>

  <div data-panel="vlm"><VlmDetail /></div>
  <div data-panel="imitation"><ImitationDetail /></div>
  <div data-panel="vision"><VisionDetail /></div>
  <div data-panel="motion-planner"><MotionPlannerDetail /></div>

  <!-- 패널 끝: 다음 모듈로 -->
  <div data-tabs-only hidden class="mt-12 flex justify-end">
    <button type="button" data-next class="rounded-full bg-ink px-6 py-3 font-semibold text-white transition-colors hover:bg-accent"></button>
  </div>
</div>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const root = document.querySelector<HTMLElement>('[data-software-tabs]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-tab-link]')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-tab-button]')];
    const bar = root.querySelector<HTMLElement>('[data-tab-bar]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const keys = cards.map((c) => c.dataset.tab!);
    const names = buttons.map((b) => b.textContent!.trim());

    // JS가 있을 때만 쓰는 안내·탭 줄·다음 버튼
    for (const el of root.querySelectorAll<HTMLElement>('[data-tabs-only]')) el.hidden = false;

    const show = (key: string) => {
      for (const card of cards) card.toggleAttribute('data-active', card.dataset.tab === key);
      for (const panel of panels) panel.hidden = panel.dataset.panel !== key;
      for (const link of links) link.setAttribute('aria-current', String(link.dataset.tabLink === key));
      for (const button of buttons) button.setAttribute('aria-selected', String(button.dataset.tabButton === key));
      const after = (keys.indexOf(key) + 1) % keys.length;
      next.dataset.key = keys[after];
      next.textContent = after === 0 ? `처음으로: ${names[after]} ↑` : `다음: ${names[after]} →`;
      // 숨겼던 패널이 보이면 높이가 바뀌므로 스크롤 애니메이션 위치를 다시 계산
      ScrollTrigger.refresh();
    };

    // 고른 모듈을 보여 주고 탭 줄이 화면 위에 오게 스크롤
    const open = (key: string) => {
      show(key);
      history.replaceState(null, '', `#software-${key}`);
      const smooth = matchMedia('(prefers-reduced-motion: no-preference)').matches;
      bar.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
    };

    for (const link of links) {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        open(link.dataset.tabLink!);
      });
    }
    for (const button of buttons) button.addEventListener('click', () => open(button.dataset.tabButton!));
    next.addEventListener('click', () => open(next.dataset.key!));

    // 주소에 #software-<모듈>이 있으면 그 모듈부터, 없으면 첫 모듈
    const fromHash = keys.find((k) => location.hash === `#software-${k}`);
    show(fromHash ?? keys[0]);
  }
</script>

<style>
  /* 탭으로 하나씩 볼 때는 상세 위쪽 구분선을 없애고 탭 줄에 붙인다. JS가 없으면 상세가 이어지므로 구분선을 남긴다. */
  [data-tab-bar]:not([hidden]) ~ [data-panel] > :global(:first-child) {
    margin-top: 1.5rem;
    border-top: 0;
    padding-top: 0;
  }
</style>
