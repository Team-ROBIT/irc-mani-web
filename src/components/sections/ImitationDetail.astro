---
import Media from '../Media.astro';
import { software, imitation } from '../../data/site';

const owner = software.modules.find((m) => m.key === 'imitation')?.owner;
---

<div id="software-imitation" class="mt-24 border-t border-neutral-200 pt-16">
  <p class="text-sm font-semibold text-accent">소프트웨어 상세 · 담당 {owner}</p>
  <h3 class="reveal mt-3 text-4xl font-extrabold tracking-tight lg:text-5xl">모방학습</h3>
  <p class="reveal mt-6 max-w-3xl text-2xl leading-snug font-bold">{imitation.easy}</p>
  <p class="mt-4 text-neutral-600">
    <span class="font-mono font-semibold text-ink">{imitation.model}</span> · {imitation.runtime}
  </p>

  <div class="reveal mt-10 rounded-3xl bg-ink p-7 text-white sm:p-9">
    <p class="text-xl font-bold">{imitation.principle.title}</p>
    <p class="mt-3 max-w-4xl leading-relaxed text-neutral-300">{imitation.principle.body}</p>
  </div>

  <ol class="mt-10 grid gap-4 md:grid-cols-3">
    {
      imitation.flow.map((f, i) => (
        <li class="reveal rounded-3xl border border-neutral-200 bg-white p-6" style={`--i: ${i}`}>
          <p class="text-sm font-bold text-accent">{String(i + 1).padStart(2, '0')}</p>
          <p class="mt-1 text-2xl font-bold">{f.name}</p>
          <p class="mt-3 leading-relaxed text-neutral-700">{f.body}</p>
        </li>
      ))
    }
  </ol>

  <div class="mt-10 grid gap-4 lg:grid-cols-[1fr_auto_1fr] lg:items-stretch">
    <div class="reveal rounded-3xl border border-neutral-200 bg-white p-6">
      <p class="text-sm font-semibold text-neutral-500">정책 입력</p>
      <ul class="mt-3 space-y-2">
        {imitation.io.input.map((t) => <li class="leading-relaxed">{t}</li>)}
      </ul>
    </div>
    <div class="hidden items-center text-3xl text-accent lg:flex" aria-hidden="true">→</div>
    <div class="reveal rounded-3xl border border-neutral-200 bg-white p-6" style="--i: 1">
      <p class="text-sm font-semibold text-neutral-500">정책 출력</p>
      <ul class="mt-3 space-y-2">
        {imitation.io.output.map((t) => <li class="leading-relaxed">{t}</li>)}
      </ul>
    </div>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <div class="bg-neutral-100 text-neutral-500">
      <Media id="software/imitation-collect" label="리더암으로 데이터를 모으는 장면" spec="16:9 · 가로 1600px 이상" class="aspect-[16/9] w-full rounded-3xl" sizes="(min-width: 768px) 50vw, 100vw" />
    </div>
    <div class="bg-neutral-100 text-neutral-500">
      <Media id="software/imitation-run" label="정책이 혼자 수행하는 장면" spec="16:9 · 가로 1600px 이상" class="aspect-[16/9] w-full rounded-3xl" sizes="(min-width: 768px) 50vw, 100vw" />
    </div>
  </div>

  <h4 class="mt-16 text-2xl font-bold">구현 내용 {imitation.features.length}가지</h4>
  <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {
      imitation.features.map((f, i) => (
        <article class="reveal flex flex-col rounded-3xl border border-neutral-200 bg-white p-6" style={`--i: ${i % 3}`}>
          <p class="text-sm font-bold text-accent">{String(i + 1).padStart(2, '0')}</p>
          <h5 class="mt-1 text-2xl font-bold">{f.name}</h5>
          <p class="mt-3 leading-relaxed text-neutral-700">{f.easy}</p>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {f.tags.map((t) => <li class="rounded-full bg-neutral-100 px-2.5 py-1 font-mono text-xs text-neutral-700">{t}</li>)}
          </ul>
          <div class="mt-auto pt-5">
            <details class="border-t border-neutral-200 pt-4">
              <summary class="cursor-pointer text-sm font-semibold text-accent select-none">기술 자세히 보기</summary>
              <div class="mt-4 space-y-4 text-sm leading-relaxed text-neutral-600">
                <p>{f.tech}</p>
                {f.improvements?.map((p) => (
                  <div class="rounded-2xl bg-neutral-50 p-4">
                    <p class="text-xs font-semibold text-neutral-500">직접 개선</p>
                    <p class="mt-1">
                      <span class="font-semibold text-ink">문제</span> {p.problem}
                    </p>
                    <p class="mt-1">
                      <span class="font-semibold text-ink">해결</span> {p.solution}
                    </p>
                  </div>
                ))}
              </div>
            </details>
          </div>
        </article>
      ))
    }
  </div>

  <h4 class="mt-16 text-2xl font-bold">skill과 학습 데이터</h4>
  <p class="mt-3 max-w-4xl text-neutral-600">{imitation.trainingNote}</p>
  <div class="mt-6 overflow-x-auto rounded-3xl border border-neutral-200 bg-white">
    <table class="w-full min-w-[40rem] text-left text-sm">
      <thead class="border-b border-neutral-200 text-neutral-500">
        <tr>
          <th class="p-4 font-semibold">작업</th>
          <th class="p-4 font-semibold">skill</th>
          <th class="p-4 font-semibold">시연 에피소드</th>
          <th class="p-4 font-semibold">시연 시간</th>
          <th class="p-4 font-semibold">실행 시간</th>
        </tr>
      </thead>
      <tbody>
        {
          imitation.skills.map((r) => (
            <tr class="border-b border-neutral-100 last:border-0">
              <td class="p-4 font-semibold">{r.task}</td>
              <td class="p-4 font-mono text-xs">{r.skill}</td>
              <td class="p-4 font-bold">{r.episodes}개</td>
              <td class="p-4">{r.minutes}</td>
              <td class="p-4">{r.run}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-sm text-neutral-500">{imitation.skillsNote}</p>

</div>
