---
import SectionHeader from './SectionHeader.astro';
import Media from '../Media.astro';
import { timeline } from '../../data/site';
---

<SectionHeader eyebrow="개발 과정" title={timeline.title} intro={timeline.intro} pending={timeline.pending ? '자료 준비 중' : undefined} />

<ol class="mt-16 space-y-14 border-l-2 border-neutral-200">
  {
    timeline.stages.map((s, i) => (
      <li class="reveal relative pl-8 sm:pl-12">
        <span class="absolute top-1.5 -left-[7px] size-3 rounded-full bg-accent" aria-hidden="true" />
        <div class="grid gap-8 md:grid-cols-2 md:gap-14">
          <div>
            <p class="text-sm font-semibold text-neutral-500">
              <span class="font-bold text-accent">{String(i + 1).padStart(2, '0')}</span> · {s.period}
            </p>
            <h3 class="mt-2 text-3xl font-extrabold tracking-tight lg:text-4xl">{s.name}</h3>
            <p class="mt-4 text-lg leading-relaxed text-neutral-600">{s.body}</p>
            <div class="mt-6 border-t border-neutral-200 pt-3">
              <p class="text-sm text-neutral-500">시행착오</p>
              <p class="mt-1 leading-relaxed text-neutral-600">{s.trial}</p>
            </div>
          </div>
          <div class="overflow-hidden rounded-3xl bg-neutral-100 text-neutral-500">
            <Media
              id={`process/${s.key}`}
              label={`${s.name} 과정 사진`}
              spec="16:9 · 가로 1600px 이상"
              class="aspect-[16/9] w-full"
              sizes="(min-width: 768px) 40vw, 100vw"
            />
          </div>
        </div>
      </li>
    ))
  }
</ol>
