---
import SectionHeader from './SectionHeader.astro';
import { tasks } from '../../data/site';
---

<SectionHeader eyebrow="수행 Task" title={tasks.title} intro={tasks.intro} pending={tasks.pending ? '확정 전' : undefined} />

<div class="mt-12 flex flex-wrap items-center gap-2 text-sm">
  <span class="mr-2 font-semibold text-neutral-500">처리 우선순위</span>
  {
    tasks.priorities.map((p, i) => (
      <>
        {i > 0 && <span class="text-neutral-400">›</span>}
        <span class:list={['reveal rounded-full px-3 py-1 font-semibold', i === 0 ? 'bg-accent text-white' : 'bg-neutral-200/70']} style={`--i: ${i}`}>
          {p.name}
        </span>
      </>
    ))
  }
</div>

<ol class="mt-10 grid gap-px overflow-hidden rounded-3xl border border-neutral-200 bg-neutral-200 sm:grid-cols-2 lg:grid-cols-4">
  {
    tasks.items.map((t, i) => (
      <li class="bg-white p-7 first:col-span-full">
        <div class="reveal" style={`--i: ${i}`}>
          <div class="flex items-baseline justify-between gap-4">
            <span class="text-sm font-bold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-xs text-neutral-500">{t.cause}</span>
          </div>
          <h3 class="mt-3 text-2xl font-bold">{t.name}</h3>
          <p class="mt-2 leading-relaxed text-neutral-600">{t.action}</p>
        </div>
      </li>
    ))
  }
</ol>
