---
import SectionHeader from './SectionHeader.astro';
import Media from '../Media.astro';
import { team } from '../../data/site';
---

<SectionHeader eyebrow="팀" title={team.title} />

<ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
  {
    team.members.map((m, i) => (
      <li class="reveal" style={`--i: ${i}`}>
        <div class="overflow-hidden rounded-3xl bg-neutral-100 text-neutral-500">
          <Media id={m.photo} label={`${m.name} 사진`} spec="3:4 · 세로 800px 이상 · 사용 동의 필요" class="aspect-[3/4] w-full object-top" sizes="(min-width: 1024px) 25vw, 50vw" />
        </div>
        <p class="mt-5 text-sm font-semibold text-neutral-500">{m.position}</p>
        <h3 class="mt-1 text-2xl font-bold">{m.name}</h3>
        <ul class="mt-2 space-y-1 text-neutral-600">
          {m.roles.map((r) => <li>{r}</li>)}
        </ul>
      </li>
    ))
  }
</ul>
