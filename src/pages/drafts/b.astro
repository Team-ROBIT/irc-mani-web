---
// B 확장 시안 B: 챕터 내비 — 좌측 고정 목차, 본문은 문서처럼 이어서
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DraftBar from '../../components/DraftBar.astro';
import Why from '../../components/sections/Why.astro';
import Tasks from '../../components/sections/Tasks.astro';
import System from '../../components/sections/System.astro';
import Hardware from '../../components/sections/Hardware.astro';
import Software from '../../components/sections/Software.astro';
import Team from '../../components/sections/Team.astro';
import { project, media, nav } from '../../data/site';
---

<Base title={`${project.name} · 시안 B`} bodyClass="bg-paper text-ink">
  <section id="top" class="wrap grid gap-10 pt-10 pb-20 lg:grid-cols-[1fr_1.15fr] lg:items-center lg:pt-16">
    <div>
      <p class="text-sm font-semibold text-accent">Team {project.team} · {project.contest}</p>
      <h1 class="mt-4 text-[clamp(3.5rem,9vw,8.5rem)] leading-[0.9] font-black tracking-[-0.04em]">{project.name}</h1>
      <p class="mt-8 text-2xl leading-snug font-bold sm:text-3xl">{project.headline}</p>
      <p class="mt-5 text-lg leading-relaxed text-neutral-600">{project.summary}</p>
    </div>
    <div class="overflow-hidden rounded-3xl bg-neutral-200 text-neutral-500">
      <Media {...media.hero} class="aspect-[4/3] w-full" sizes="(min-width: 1024px) 55vw, 100vw" />
    </div>
  </section>

  <div class="wrap grid gap-12 border-t border-neutral-200 lg:grid-cols-[13rem_1fr] xl:gap-20">
    <aside class="hidden lg:block">
      <nav class="sticky top-0 py-16">
        <p class="text-lg font-extrabold">{project.name}</p>
        <ol class="mt-8 space-y-1 text-sm">
          {
            nav.map((n, i) => (
              <li>
                <a href={`#${n.id}`} class="group flex gap-3 rounded-lg px-3 py-2 text-neutral-500 hover:bg-white hover:text-ink">
                  <span class="font-bold text-neutral-400 group-hover:text-accent">{String(i + 1).padStart(2, '0')}</span>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <main class="min-w-0 divide-y divide-neutral-200">
      <section id="why" class="py-20 lg:py-28"><Why /></section>
      <section id="tasks" class="py-20 lg:py-28"><Tasks /></section>
      <section id="system" class="py-20 lg:py-28"><System /></section>
      <section id="hardware" class="py-20 lg:py-28"><Hardware /></section>
      <section id="software" class="py-20 lg:py-28"><Software /></section>
      <section id="team" class="py-20 lg:py-28"><Team /></section>
    </main>
  </div>

  <SiteFooter />
  <DraftBar current="b" />
</Base>
