---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Why from '../components/sections/Why.astro';
import Tasks from '../components/sections/Tasks.astro';
import Results from '../components/sections/Results.astro';
import System from '../components/sections/System.astro';
import Hardware from '../components/sections/Hardware.astro';
import Software from '../components/sections/Software.astro';
import Process from '../components/sections/Process.astro';
import OpenSource from '../components/sections/OpenSource.astro';
import Team from '../components/sections/Team.astro';
import { project, media, nav } from '../data/site';
---

<Base bodyClass="bg-paper text-ink">
  <div class="scroll-progress fixed inset-x-0 top-0 z-50 h-0.5 origin-left bg-accent" aria-hidden="true"></div>

  <!-- 좁은 화면: 상단 고정 챕터 바 -->
  <div class="sticky top-0 z-40 border-b border-neutral-200/70 bg-paper/90 backdrop-blur lg:hidden">
    <div class="flex items-center gap-4 px-5 sm:px-8">
      <a href="#top" class="shrink-0 py-3 text-base font-extrabold">{project.name}</a>
      <nav data-spy-scroller class="relative flex gap-1 overflow-x-auto py-2 text-sm [scrollbar-width:none]">
        {
          nav.map((n) => (
            <a
              data-spy
              href={`#${n.id}`}
              class="shrink-0 rounded-full px-3 py-1.5 whitespace-nowrap text-neutral-500 aria-[current=true]:bg-ink aria-[current=true]:text-white"
            >
              {n.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <div class="lg:grid lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-x-6 lg:pl-5 xl:grid-cols-[12rem_minmax(0,1fr)] xl:gap-x-8 xl:pl-8">
    <!-- 넓은 화면: 왼쪽 가장자리에 붙인 챕터 목차 -->
    <aside class="hidden lg:block">
      <nav class="sticky top-0 py-12">
        <a href="#top" class="block text-lg font-extrabold">{project.name}</a>
        <p class="text-xs text-neutral-500">Team {project.team}</p>
        <ol class="mt-8 space-y-1 border-l border-neutral-200 text-sm">
          {
            nav.map((n, i) => (
              <li>
                <a
                  data-spy
                  href={`#${n.id}`}
                  class="group -ml-px flex gap-3 border-l-2 border-transparent py-2 pl-4 text-neutral-500 transition-colors duration-300 hover:text-ink aria-[current=true]:border-accent aria-[current=true]:font-semibold aria-[current=true]:text-ink"
                >
                  <span class="font-bold text-neutral-400 group-aria-[current=true]:text-accent">{String(i + 1).padStart(2, '0')}</span>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <div class="mx-auto w-full max-w-[1500px] min-w-0 px-5 sm:px-8 lg:px-10 xl:px-14">
      <main class="divide-y divide-neutral-200">
        <section id="top" class="hero-pin">
          <div class="hero-stick grid gap-10 pt-10 pb-20 xl:grid-cols-[1fr_1.15fr] xl:items-center xl:pt-16">
            <div class="hero-out">
              <p class="intro text-sm font-semibold text-accent">Team {project.team} · {project.contest}</p>
              <h1 class="intro mt-4 text-[clamp(3.5rem,9vw,8.5rem)] leading-[0.9] font-black tracking-[-0.04em]" style="--i: 1">{project.name}</h1>
              <p class="intro mt-8 text-2xl leading-snug font-bold sm:text-3xl" style="--i: 2">{project.headline}</p>
              <p class="intro mt-5 text-lg leading-relaxed text-neutral-600" style="--i: 3">{project.summary}</p>
            </div>
            <div class="intro overflow-hidden rounded-3xl bg-neutral-200 text-neutral-500" style="--i: 2">
              <Media {...media.hero} class="hero-zoom aspect-[4/3] w-full" sizes="(min-width: 1280px) 55vw, 100vw" />
            </div>
          </div>
        </section>
        <section id="why" class="py-20 lg:py-28"><Why /></section>
        <section id="tasks" class="py-20 lg:py-28"><Tasks /></section>
        <section id="results" class="py-20 lg:py-28"><Results /></section>
        <section id="system" class="py-20 lg:py-28"><System /></section>
        <section id="hardware" class="py-20 lg:py-28"><Hardware /></section>
        <section id="software" class="py-20 lg:py-28"><Software /></section>
        <section id="process" class="py-20 lg:py-28"><Process /></section>
        <section id="opensource" class="py-20 lg:py-28"><OpenSource /></section>
        <section id="team" class="py-20 lg:py-28"><Team /></section>
      </main>
      <SiteFooter />
    </div>
  </div>
</Base>

<script>
  import '../scripts/motion';

  // 스크롤 위치에 맞춰 현재 챕터 링크에 aria-current="true"를 붙인다.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-spy]')];
  const sections = [...new Set(links.map((l) => l.hash.slice(1)))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  function setActive(id: string) {
    for (const link of links) {
      const on = link.hash === `#${id}`;
      link.setAttribute('aria-current', String(on));
      const box = link.closest<HTMLElement>('[data-spy-scroller]');
      if (on && box) box.scrollTo({ left: link.offsetLeft - (box.clientWidth - link.offsetWidth) / 2, behavior: 'smooth' });
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) if (entry.isIntersecting) setActive(entry.target.id);
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );
  sections.forEach((s) => observer.observe(s));

  // 맨 아래에서는 마지막 챕터가 조건 구간에 닿지 않을 수 있어 따로 처리한다.
  window.addEventListener(
    'scroll',
    () => {
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) setActive(sections[sections.length - 1].id);
    },
    { passive: true },
  );
  setActive(sections[0].id);
</script>
